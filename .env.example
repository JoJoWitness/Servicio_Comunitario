# Copia este archivo a .env (en la raíz del repo) antes de `docker compose up`.

# --- PostgreSQL (contenedor db) ---
POSTGRES_DB=notas_operatorias
POSTGRES_USER=notas
POSTGRES_PASSWORD=cambiame

# --- API (contenedor server) ---
# Vacío o ausente = desarrollo: la base se reconstruye desde cero en cada
# arranque y se cargan las cuentas y pacientes de prueba.
# PROD = no se borra nada; solo se aplica el esquema y el catálogo clínico.
# ENVIRONMENT=PROD

# Solo para un servidor de pruebas con ENVIRONMENT=PROD: carga (sin borrar ni
# duplicar) los datos de prueba. Nunca en el servidor real.
# DATOS_PRUEBA=true

# Orígenes extra autorizados por CORS, separados por comas. El del frontend web
# de este compose (http://localhost:3000) ya va incluido.
# ALLOWED_ORIGINS=https://notas.hospital.example

# true solo si un frontend se sirve desde OTRO dominio que la API (la app de
# escritorio Tauri apuntando a este servidor, por ejemplo). Requiere HTTPS.
# COOKIE_CROSS_SITE=true

# --- Bucket de adjuntos (contenedor s3 en local; en Railway, el Bucket) ---
S3_ACCESS_KEY=notas
S3_SECRET_KEY=notas12345
S3_BUCKET=notas-adjuntos

# --- Respaldos (docker compose run --rm backup) ---
BACKUP_PREFIX=respaldos
BACKUP_KEEP_DAYS=30

# --- Frontend web (contenedor frontend) ---
FRONTEND_PORT=3000
