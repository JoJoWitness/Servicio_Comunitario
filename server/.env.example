# Copia este archivo a .env para desarrollo. En producción (ENVIRONMENT=PROD)
# las variables se toman del entorno del hosting y el .env no se lee.

# Conexión a PostgreSQL.
DATABASE_URI=postgres://usuario:clave@localhost:5432/notas_operatorias

# Puerto HTTP. Por defecto 8080.
PORT=8080

# Sin PROD se asume desarrollo: la base se reconstruye desde cero en cada
# arranque y se cargan las cuentas y pacientes de prueba.
# ENVIRONMENT=PROD

# Orígenes adicionales autorizados por CORS, separados por comas. Los de
# desarrollo y los de la app de escritorio ya van incluidos.
# ALLOWED_ORIGINS=https://notas.hospital.example

# true cuando el frontend se sirve desde otro dominio que la API (la app de
# escritorio, Vercel): la cookie de sesión sale con SameSite=None; Secure.
# COOKIE_CROSS_SITE=true

# Solo para el servidor de pruebas en producción: al arrancar carga (o pone al
# día, sin borrar ni duplicar) las cuentas, pacientes, notas y biopsias de
# prueba de models/schemas/sample_data*.sql. Nunca en el servidor real.
# DATOS_PRUEBA=true

# Bucket S3 para las fotos de cédula de los pacientes (y los respaldos de la
# base, ver ../backup). Sin BUCKET_NAME las fotos se guardan en la base, como
# en v0.4.0. Se aceptan también los nombres que expone un Bucket de Railway
# (ENDPOINT, ACCESS_KEY_ID, SECRET_ACCESS_KEY, REGION, BUCKET).
# AWS_ENDPOINT_URL=http://localhost:9000
# AWS_ACCESS_KEY_ID=notas
# AWS_SECRET_ACCESS_KEY=notas12345
# AWS_REGION=us-east-1
# BUCKET_NAME=notas-adjuntos
# "path" para el S3 local de docker compose (o MinIO); sin definir (virtual-host) para Railway.
# AWS_S3_URL_STYLE=path
