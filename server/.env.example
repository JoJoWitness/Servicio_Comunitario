# Copia este archivo a .env para desarrollo. En producción (ENVIRONMENT=PROD)
# las variables se toman del entorno del hosting y el .env no se lee.

# Conexión a PostgreSQL.
DATABASE_URI=postgres://usuario:clave@localhost:5432/notas_operatorias

# Puerto HTTP. Por defecto 8080.
PORT=8080

# Sin PROD se asume desarrollo: la base se reconstruye desde cero en cada
# arranque y se cargan las cuentas y pacientes de prueba.
# ENVIRONMENT=PROD

# Orígenes adicionales autorizados por CORS, separados por comas. Los de
# desarrollo y los de la app de escritorio ya van incluidos.
# ALLOWED_ORIGINS=https://notas.hospital.example

# true cuando el frontend se sirve desde otro dominio que la API (la app de
# escritorio, Vercel): la cookie de sesión sale con SameSite=None; Secure.
# COOKIE_CROSS_SITE=true
